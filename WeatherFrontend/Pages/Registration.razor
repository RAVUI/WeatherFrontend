@page "/register"
@layout LoginLayout
@using MudBlazor
@inject AuthService AuthService
@inject NavigationManager Navigation

<style>
    .page-container {
        height: 100vh;
        width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center;
        background-image: url('images/WeatherBG3.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        position: fixed;
        top: 0;
        left: 0;
        margin: 0;
        overflow: hidden;
    }

    .form-container {
        width: 400px;
        background-color: rgba(255, 255, 255, 0.9);
        padding: 40px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .title {
        font-size: 32px;
        font-weight: 600;
        color: #333;
        margin-bottom: 4px;
        text-align: center;
    }

    .subtitle {
        color: #666;
        margin-bottom: 16px;
        text-align: center;
    }

    .tabs {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    .tab {
        padding: 8px 16px;
        cursor: pointer;
        color: #666;
    }

        .tab.active {
            color: #6366F1;
            border-bottom: 2px solid #6366F1;
        }

    .input-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .register-button {
        width: 100%;
        padding: 12px;
        background-color: #6366F1;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 500;
        margin-top: 16px;
    }
</style>

<div class="page-container">
    <div class="form-container">
        <div class="title">Create Account</div>
        <div class="subtitle">Register to get started</div>

        <div class="tabs">
            <div class="tab" @onclick="@(() => Navigation.NavigateTo("/login"))">Login</div>
            <div class="tab active">Register</div>
        </div>

        <div class="input-container">
            <MudTextField @bind-Value="email"
                          Placeholder="Enter your email"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Margin="Margin.None"
                          @onkeypress="HandleKeyPress" />

            <MudTextField @bind-Value="password"
                          Placeholder="Enter your password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          FullWidth="true"
                          Margin="Margin.None"
                          @onkeypress="HandleKeyPress" />

            <MudTextField @bind-Value="confirmPassword"
                          Placeholder="Confirm your password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          FullWidth="true"
                          Margin="Margin.None"
                          @onkeypress="HandleKeyPress" />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudText Color="Color.Error">@errorMessage</MudText>
            }

            <button class="register-button" @onclick="HandleRegister">
                REGISTER
            </button>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private string errorMessage = "";

    private async Task HandleRegister()
    {
        if (password != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        try
        {
            var result = await AuthService.Register(email, password);
            if (result)
            {
                errorMessage = "Registration successful! Please log in.";
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = "Registration failed. Email might already be in use.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred during registration: {ex.Message}";
        }
    }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleRegister();
        }
    }
}
