@inject NavigationManager Navigation

@code {
    private bool isExpanded = false;

    [Parameter]
    public EventCallback OnProfileClick { get; set; }

    void ToggleSidebar()
    {
        isExpanded = !isExpanded;
    }
}

<div style="width: @(isExpanded ? "200px" : "70px"); background-color: #ffffff; box-shadow: 3px 0 10px rgba(0, 0, 0, 0.15); display: flex; flex-direction: column; padding-top: 7px; border-radius: 15px 15px 15px; margin: 10px 0 10px 10px; transition: width 0.3s ease; align-items: center; gap: 7px;">
    
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Class="sidebar-icon" @onclick="ToggleSidebar" />

   
    <MudNavLink Href="/home" Icon="@Icons.Material.Filled.Home" Class="sidebar-item">
        <span class="sidebar-text">Home</span>
    </MudNavLink>
    <MudNavLink Href="/favorites" Icon="@Icons.Material.Filled.Favorite" Class="sidebar-item">
        <span class="sidebar-text">Favorites</span>
    </MudNavLink>
    <MudNavLink Href="/history" Icon="@Icons.Material.Filled.History" Class="sidebar-item">
        <span class="sidebar-text">History</span>
    </MudNavLink>
    <MudNavLink Href="/forecast" Icon="@Icons.Material.Filled.WbSunny" Class="sidebar-item">
        <span class="sidebar-text">Forecast</span>
    </MudNavLink>
    <MudNavLink @onclick="OnProfileClick"
                Icon="@Icons.Material.Filled.AccountCircle"
                Class="sidebar-item"
                Style="margin-top: auto; margin-bottom: 20px;">
        <span class="sidebar-text">Profile</span>
    </MudNavLink>
</div>

<style>
    .sidebar-item {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 10px;
        text-decoration: none;
        transition: 0.3s;
    }

    .sidebar-text {
        display: @(isExpanded ? "inline" : "none");
        transition: opacity 0.3s ease;
    }

    .sidebar-icon {
        border-radius: 0;
        transition: 0.3s;
        width: 40px;
        height: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: transparent;
        cursor: pointer;
    }

    .sidebar-item:hover {
        border-radius: 8px;
    }
</style>