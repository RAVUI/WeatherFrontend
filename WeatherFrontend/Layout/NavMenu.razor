@inject NavigationManager Navigation
@inject IDialogService DialogService

@code {
    private bool isExpanded = false;
    void ToggleSidebar()
    {
        isExpanded = !isExpanded;
    }

    private void OpenProfileDialog()
    {
        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            };

        var dialog = DialogService.Show<ProfileDialog>("User Profile", options);
        _ = HandleDialogResult(dialog);
    }

    private async Task HandleDialogResult(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (result.Canceled)
        {
            Console.WriteLine("Profile dialog was canceled.");
        }
        else
        {
            var profile = result.Data as ProfileDialog.UserProfile;
            if (profile != null)
            {
                Console.WriteLine($"Profile updated: ID: {profile.Id}, Email: {profile.Email}");
                
            }
            else
            {
                Console.WriteLine("Profile dialog was closed without returning profile data.");
            }
        }
    }
}

<div style="width: @(isExpanded ? "200px" : "70px"); background-color: #ffffff; box-shadow: 3px 0 10px rgba(0, 0, 0, 0.15); display: flex; flex-direction: column; padding-top: 10px; border-radius: 15px 15px 15px; margin: 10px 0 10px 10px; transition: width 0.3s ease; align-items: center; gap: 10px;">
    @* Menu Button (Toggles Sidebar) *@
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Class="sidebar-icon" @onclick="ToggleSidebar" />

    @* Navigation Icons with Names *@
    <MudNavLink Href="/home" Icon="@Icons.Material.Filled.Home" Class="sidebar-item">
        <span class="sidebar-text">Home</span>
    </MudNavLink>
    <MudNavLink Href="/favorites" Icon="@Icons.Material.Filled.Favorite" Class="sidebar-item">
        <span class="sidebar-text">Favorites</span>
    </MudNavLink>
    <MudNavLink Href="/history" Icon="@Icons.Material.Filled.History" Class="sidebar-item">
        <span class="sidebar-text">History</span>
    </MudNavLink>
    <MudNavLink @onclick="OpenProfileDialog"
                Icon="@Icons.Material.Filled.AccountCircle"
                Class="sidebar-item"
                Style="margin-top: auto; margin-bottom: 20px;">
        <span class="sidebar-text">Profile</span>
    </MudNavLink>
</div>

<style>
    .sidebar-item {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 10px;
        text-decoration: none;
        /* color: black; */
        transition: 0.3s;
    }

    .sidebar-text {
        display: @(isExpanded ? "inline" : "none");
        transition: opacity 0.3s ease;
    }

    .sidebar-icon {
        border-radius: 0;
        transition: 0.3s;
        width: 40px;
        height: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: transparent;
        cursor: pointer;
    }

    .sidebar-item:hover {
        border-radius: 8px;
    }
</style>